{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/archpuccinn_flat.png",
    "width": 36,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " \u001b[38;2;198;160;246m\u001b[0m ",
    "constants": [
      "\u001b[38;2;240;198;198m─────────────────\u001b[0m"
    ],
    "color": {
      "keys": "38;2;245;189;230"
    },
    "key": {
      "type": "icon",
      "paddingLeft": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;240;198;198m┌\u001b[0m{$1} \u001b[38;2;198;160;246mHardware Information\u001b[0m {$1}\u001b[38;2;240;198;198m┐\u001b[0m"
    },
    "host",
    "cpu",
    "gpu",
    "disk",
    "memory",
    "display",
    {
      "type": "custom",
      "format": "\u001b[38;2;240;198;198m└\u001b[0m{$1}\u001b[38;2;240;198;198m──────────────────────\u001b[0m{$1}\u001b[38;2;240;198;198m┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;240;198;198m┌\u001b[0m{$1} \u001b[38;2;198;160;246mSoftware Information\u001b[0m {$1}\u001b[38;2;240;198;198m┐\u001b[0m"
    },
    "os",
    "kernel",
    "lm",
    "de",
    "wm",
    "shell",
    "terminal",
    "font",
    "icons",
    "packages",
    "uptime",
    {
      "type": "custom",
      "format": "\u001b[38;2;240;198;198m└\u001b[0m{$1}\u001b[38;2;240;198;198m──────────────────────\u001b[0m{$1}\u001b[38;2;240;198;198m┘\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21
    }
  ]
}
